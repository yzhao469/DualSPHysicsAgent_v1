# =============================================================================
#  dualsphysics-maf — environment configuration
# =============================================================================
#
#  Usage:
#      cp .env.example .env
#      # then edit .env and set OPENAI_API_KEY
#
#  .env is git-ignored; this template is not.  Both main.py and gui_api.py
#  load .env from this directory at startup.
#
#  IMPORTANT FOR REPRODUCTION
#  --------------------------
#  The four *_MODEL variables below are set to the values used to produce
#  every result reported in the accompanying paper.  They are NOT the values
#  the code falls back to when the variable is unset — the in-code fallbacks
#  are older/cheaper models (noted per variable).  Running without a .env
#  will therefore NOT reproduce the published runs.
#
# =============================================================================


# -----------------------------------------------------------------------------
#  Credentials  (required)
# -----------------------------------------------------------------------------

# OpenAI API key.  Required by every LLM role.
OPENAI_API_KEY=sk-your-key-here


# -----------------------------------------------------------------------------
#  Model selection, one variable per role
# -----------------------------------------------------------------------------
#  Each variable maps to a role in Section 3.3 of the paper.  Node names below
#  match the boxes in Figure 1 and the rows of Table 1.
#
#  Roles are phase-scoped: they share no memory and exchange no messages.  The
#  split into four variables exists so that a cheaper model can be substituted
#  for the auxiliary services without touching the planning or analysis roles.
# -----------------------------------------------------------------------------

# PLANNING node — generates the simulation plan (geometry block + 14 physics /
# run-control parameters) as schema-constrained JSON.
# Used by: agents/simulation_agent.py
# Code fallback if unset: gpt-4o
PLANNER_MODEL=gpt-5.4

# REVIEW node (pre-processing HITL loop) and the two stateless helper services
# it shares with the ANALYSIS node: reference-file resolution and question
# answering.
# Used by: agents/executors/plan_and_build.py, agents/utils/intent.py
# Code fallback if unset: gpt-4o-mini
INTENT_MODEL=gpt-5.4

# Stateless patching services.  Converts a natural-language change request
# into a minimal JSON difference over the plan (pre-processing), or rewrites
# the post-processing shell script (post-processing).  These are single-shot
# calls with no conversation history — they are not workflow nodes.
# Used by: agents/utils/patch_utils.py, agents/utils/script_utils.py
# Code fallback if unset: gpt-4o
PATCH_MODEL=gpt-5.4

# ANALYSIS node — post-processing HITL loop (script edits, ad-hoc Python
# analysis, plotting, offscreen 3D rendering).
# Used by: agents/executors/analyze.py
# Code fallback if unset: gpt-4o
ANALYSIS_MODEL=gpt-5.4


# -----------------------------------------------------------------------------
#  Settings that are fixed in code (listed here for reference; not overridable)
# -----------------------------------------------------------------------------
#    temperature            0    for all tool-use and patching calls
#                           0.3  for the free-form question-answering service
#    context window         20 most recent non-system entries per conversation;
#                           older tool outputs compressed to a single line
#    build recovery limit   3 automatic rebuild attempts before escalating to
#                           a full replan
#    GPU selection          automatic (presence of nvidia-smi); no variable
# -----------------------------------------------------------------------------
